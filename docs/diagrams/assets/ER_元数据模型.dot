digraph ER { graph [rankdir=LR, bgcolor="#ffffff", pad="0.25", nodesep="0.48", ranksep="1.0", splines=polyline]; node [shape=record, fontname="Noto Sans CJK SC", fontsize=12, color="#bcc9d7", style="filled", fillcolor="#f7fafc", penwidth=1.2, margin="0.08,0.06"]; edge [color="#8ca6ba", arrowhead=none, penwidth=1.1];
  IDENTITY [label="{IDENTITY|identity_id (PK)|public_key|status}}",fillcolor="#f7fafc"];
  DEVICE [label="{DEVICE|device_id (PK)|identity_id (FK)|device_pubkey}}",fillcolor="#f7fafc"];
  NODE [label="{NODE|node_id (PK)|device_id (FK)|capabilities}}",fillcolor="#e9f1fa"];
  LIBRARY [label="{LIBRARY|library_id (PK)|owner_id (FK)|encryption_policy}}",fillcolor="#e9f1fa"];
  ACL_GRANT [label="{ACL_GRANT|grant_id (PK)|library_id (FK)|role / subject}}",fillcolor="#f7fafc"];
  KEY_EPOCH [label="{KEY_EPOCH|key_id (PK)|library_id (FK)|epoch}}",fillcolor="#f7fafc"];
  ASSET [label="{ASSET|asset_id (PK)|library_id (FK)|origin_node_id}}",fillcolor="#e9f1fa"];
  ASSET_FILE [label="{ASSET_FILE|file_id (PK)|asset_id (FK)|sha256}}",fillcolor="#f7fafc"];
  FILE_LOCATION [label="{FILE_LOCATION|location_id (PK)|file_id / node_id|path_ref}}",fillcolor="#f7fafc"];
  ALBUM [label="{ALBUM|album_id (PK)|library_id (FK)|title}}",fillcolor="#f7fafc"];
  ALBUM_MEMBERSHIP [label="{ALBUM_MEMBERSHIP|album_id / asset_id|add_tag}}",fillcolor="#f7fafc"];
  EVENT [label="{EVENT|event_id (PK)|author_device_id|causal_parents}}",fillcolor="#e9f1fa"];
  JOB [label="{JOB|job_id (PK)|node_id (FK)|checkpoint}}",fillcolor="#f7fafc"];
  TOMBSTONE [label="{TOMBSTONE|entity_id (PK)|event_id|retention_until}}",fillcolor="#f7fafc"];
  "IDENTITY" -> "DEVICE";
  "IDENTITY" -> "LIBRARY";
  "DEVICE" -> "NODE";
  "LIBRARY" -> "ACL_GRANT";
  "LIBRARY" -> "KEY_EPOCH";
  "LIBRARY" -> "ASSET";
  "LIBRARY" -> "ALBUM";
  "LIBRARY" -> "EVENT";
  "ASSET" -> "ASSET_FILE";
  "ASSET" -> "TOMBSTONE";
  "ASSET_FILE" -> "FILE_LOCATION";
  "NODE" -> "FILE_LOCATION";
  "NODE" -> "JOB";
  "ALBUM" -> "ALBUM_MEMBERSHIP";
  "ASSET" -> "ALBUM_MEMBERSHIP";
}