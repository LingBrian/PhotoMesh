digraph G {
  graph [rankdir=TB,bgcolor="white",nodesep="0.8",ranksep="0.85",pad="0.25"];
  node [shape=box, style="rounded,filled", fillcolor="#f4f8fc",color="#91aac3",fontname="Noto Sans CJK SC",fontsize=16,margin="0.26,0.15"];
