{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["eslint.config.mjs", "packages/config/tsconfig/base.json"],
  "tasks": {
    "lint": { "dependsOn": ["^lint"], "outputs": [] },
    "typecheck": { "dependsOn": ["^typecheck"], "outputs": [] },
    "test": { "dependsOn": ["^build"], "outputs": [] },
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", "src-tauri/target/**"] }
  }
}
